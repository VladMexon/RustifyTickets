{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustifyTickets",
  "version": "0.1.0",
  "identifier": "ru.rustifytickets.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "RustifyTickets — Классификация заявок",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Классификация заявок service desk по ключевым словам",
    "longDescription": "Приложение распределяет заявки из Excel-выгрузок по категориям на основе настраиваемых списков ключевых слов, строит графики и сохраняет отчёт с диаграммами.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
